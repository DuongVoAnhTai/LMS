DATABASE_URL="your-database-url"
DIRECT_URL="your-direct-url"

JWT_SECRET=mysecretkey

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

SOCKET_PORT=4000
SOCKET_ORIGIN=http://localhost:3000

REDIS_URL=redis://default:<PASSWORD>@<HOST>:<PORT>

# AI Provider Configuration
# Choose provider: "ollama" or "gemini"
EMBEDDING_PROVIDER=ollama
GENERATION_PROVIDER=ollama

# Gemini API (required if using Gemini provider)
GEMINI_API_KEY=your-gemini-api-key

# Ollama Configuration (required if using Ollama provider)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=qwen3:8b

# Supabase Configuration (for vector store)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key